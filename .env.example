# Docker development UID/GID (optional)
#
# If unset, development builds use 1000:1000 by default. Override only when your
# host user differs from 1000:1000. Derive values from your host identity:
#
#   LOCAL_UID=$(id -u) LOCAL_GID=$(id -g) docker compose up --build -d
#
# Most developers can leave these unset.
LOCAL_UID=1000
LOCAL_GID=1000

# Application
PORT=50001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
TRUST_PROXY_HOPS=0

# Database (PostgreSQL)
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_USER=postgres
DB_POSTGRES_PASS=postgres
DB_POSTGRES_NAME=nexus_estate_dev
DB_SYNCHRONIZE=false

# JWT
CUSTOMER_JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
CUSTOMER_JWT_ACCESS_EXPIRES_IN=15m
CUSTOMER_JWT_REFRESH_EXPIRES_IN=7d
ADMIN_JWT_ACCESS_SECRET=replace-with-a-separate-32-character-secret
ADMIN_JWT_REFRESH_SECRET=replace-with-a-different-admin-refresh-secret
ADMIN_JWT_ACCESS_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# Initial Administration recovery identity (override before production migration)
INITIAL_ADMIN_EMAIL=superadmin@example.invalid
INITIAL_ADMIN_PASSWORD=replace-with-a-long-initial-password

# Redis (optional, for refresh token store)
REDIS_HOST=localhost
REDIS_PORT=6379
