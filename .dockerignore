# ─── Dependencies (installed inside container) ───
node_modules/
npm-debug.log*
yarn-error.log*
.yarn/

# ─── Build output (built inside container) ──────
dist/
build/
.temp
.tmp

# ─── Git & CI ────────────────────────────────────
.git/
.gitignore
.gitattributes
.github/
k8s/

# ─── Environment files ───────────────────────────
.env
.env.*
!.env.example

# ─── IDE / Editor ────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ─── Test & Coverage ─────────────────────────────
coverage/
.nyc_output/
test/
*.spec.ts
*.spec.js

# ─── Documentation (not needed at runtime) ───────
README.md
docs/
src/docs/

# ─── Docker files ────────────────────────────────
Dockerfile
docker-compose*.yml

# ─── Logs ────────────────────────────────────────
logs/
*.log

# ─── Reports ─────────────────────────────────────
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json